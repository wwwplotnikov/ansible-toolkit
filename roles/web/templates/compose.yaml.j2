{{ ansible_managed | comment }}
services:
  nginx:
    image: {{ web_image }}
    container_name: {{ web_project_name }}-nginx
    restart: unless-stopped
    ports:
      - "{{ web_bind_address }}:{{ web_port }}:80"
    volumes:
      - ./nginx.conf:/etc/nginx/conf.d/default.conf:ro
      - ./html:/usr/share/nginx/html:ro
    healthcheck:
      test: ["CMD", "wget", "--spider", "-q", "http://localhost/healthz"]
      interval: 30s
      timeout: 3s
      retries: 3
      start_period: 5s
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
